{
  "name": "@md/react-component-uniqueness",
  "version": "0.0.1",
  "description": "ESLint rule that enforces one canonical location per React component: duplicate declarations, raw HTML outside the canonical packages, hand-rolled components by behavior, and styled.* created in the app.",
  "license": "MIT",
  "main": "index.js",
  "bin": {
    "react-component-uniqueness": "./bin/react-component-uniqueness.js"
  },
  "files": [
    "index.js",
    "plugin.js",
    "config.js",
    "signature.js",
    "debt.js",
    "loaders.js",
    "resolve.js",
    "dom.js",
    "report.js",
    "errorTypes/",
    "scanner/",
    "bin/",
    "snapshots/",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./plugin": "./plugin.js",
    "./config": "./config.js",
    "./signature": "./signature.js",
    "./debt": "./debt.js",
    "./report": "./report.js",
    "./snapshots": "./snapshots/run.mjs",
    "./snapshots/*": "./snapshots/*"
  },
  "dependencies": {
    "minimatch": "^9.0.4"
  },
  "scripts": {
    "gen:catalog": "node scanner/main.js"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0",
    "typescript": ">=4.7.0"
  },
  "peerDependenciesMeta": {
    "puppeteer-core": { "optional": true }
  },
  "optionalDependencies": {
    "puppeteer-core": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
