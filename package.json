{
	"name": "@md-code/component-uniqueness",
	"version": "0.1.3",
	"description": "ESLint rule and CLI that find duplicate components, raw HTML that should be a canonical component, and copied parts of components, by comparing structure, CSS, behavior, accessibility and framework profile.",
	"license": "MIT",
	"keywords": [
		"eslint",
		"eslintplugin",
		"eslint-plugin",
		"duplicate-components",
		"design-system"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DrBoria/component-uniqueness.git"
	},
	"engines": {
		"node": ">=18"
	},
	"main": "index.js",
	"bin": {
		"component-uniqueness": "main.js"
	},
	"files": [
		"index.js",
		"plugin.js",
		"config.js",
		"main.js",
		"logger.js",
		"utils.js",
		"decision-maker.js",
		"report.js",
		"normalize/",
		"matcher/",
		"filter/",
		"playgrounds/",
		"README.md"
	],
	"exports": {
		".": "./index.js",
		"./plugin": "./index.js",
		"./config": "./config.js",
		"./report": "./report.js",
		"./package.json": "./package.json"
	},
	"dependencies": {
		"jsdom": "^29.1.1",
		"minimatch": "^9.0.4",
		"remeda": "^2.50.0",
		"tailwindcss": "^4.3.3",
		"typescript": ">=5.5.0 <7"
	},
	"scripts": {
		"gen:catalog": "node main.js"
	},
	"peerDependencies": {
		"eslint": ">=8.40.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
